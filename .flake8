[flake8]
max-line-length = 100
extend-ignore = E203,W503

import-restrictions =
    services\.(\w+)\.app\..* -> FORBIDDEN: services\.\1\.adapters\..*
    services\.(\w+)\.domain\..* -> FORBIDDEN: services\.\1\.(app|adapters)\..*
    services\.(\w+)\.(?!public)\..* -> FORBIDDEN: services\.(?!\1)\w+\.(?!public).*

per-file-ignores =
    services/web/app/api/main.py: E221,E222,E231,E501,E702
    # Temporary exclusions for test files - TODO: Fix these properly
    cli/tests/*.py: F401,F841,E722
    tests/**/*.py: F401,F841,F821,E722,E713,F541
    scripts/tests/*.py: F401,F841
    shared/tests/*.py: F401,F841,E722
    # Temporary exclusions for service files - TODO: Fix these properly
    services/*/app/api/main.py: F401,F841,E203
    services/auth/lib/**/*.py: F401,F821
    services/auth/adapters/**/*.py: E203
    services/auth/tests/**/*.py: F401
    entry_points/**/*.py: F401,F841,F541
    shared/core/*.py: F401,F841,F821,E722,F541
    stack/infra/**/*.py: F401
