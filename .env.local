# Local Development Environment Variables
# Copy this to .env for local development

# Environment
ENVIRONMENT=development
LOCALSTACK=true

# AWS/LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Service endpoints (for docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379
DB_HOST=postgres
DB_PORT=5432

# For running outside Docker
# REDIS_HOST=localhost
# DB_HOST=localhost

# Database
DB_SUPABASE_URL=http://localhost:54321
DB_SUPABASE_ANON_KEY=local-development-key

# Secrets (development only)
SECRET_KEY=local-development-secret-key
JWT_SECRET=local-jwt-secret
INTERNAL_API_KEY=local-internal-api-key

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LocalStack Pro (optional)
# LOCALSTACK_AUTH_TOKEN=ls-...

# Debug
DEBUG=1
LOG_LEVEL=DEBUG

# CORS (add your frontend URL)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000